{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration:dev",
    "test:all": "pnpm test:unit && pnpm test:component && pnpm test:integration:dev && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.config.unit.ts --coverage",
    "test:component": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" vitest run --config vitest.config.component.ts --coverage",
    "test:unit:deno": "deno test __tests__/unit/supabase/functions/ --allow-env --allow-net --coverage=coverage/deno && deno coverage coverage/deno --lcov --output=coverage/deno/lcov.info",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:dev": "concurrently --kill-others --success first \"pnpm dev\" \"wait-on http://localhost:3000 && pnpm test:integration\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "db:status": "tsx scripts/db-management.ts status",
    "db:seed": "tsx scripts/db-management.ts seed",
    "db:reset": "tsx scripts/db-management.ts reset",
    "pretest:integration": "pnpm db:status"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.3",
    "@tanstack/react-table": "^8.21.3",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.544.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "19.3.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4",
    "tooltip": "link:@/components/ui/tooltip",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pdf-parse": "^2.4.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
