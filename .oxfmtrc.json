{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    ".vercel/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "demo-recording/**",
    "dist/**",
    "build/**",
    "out/**",
    "supabase/.temp/**",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "package-lock.json",
    "deno.lock",
    ".env*"
  ]
}
